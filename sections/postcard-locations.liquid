{%- comment -%}
  Postcard Locations — Stockists / Pop-ups, managed as theme-editor BLOCKS.
  Add a "Stockist" or "Pop-up" block, fill in its parts, drag to reorder.
    • Stockist blocks render in block order.
    • Pop-up blocks split into current/upcoming and a "Past pop-ups" section,
      driven by the End date (YYYY-MM-DD). Past = end date before today.
  Products available is an inline rich-text field — hyperlink names to PDPs.
{%- endcomment -%}

{%- liquid
  assign now_s = 'now' | date: '%s' | plus: 0
-%}

{%- style -%}
  #shopify-section-{{ section.id }} { --accent: {{ section.settings.accent_color }}; }
  .pc-loc { background: var(--color-bg); color: var(--color-ink); }
  .pc-loc__hero { text-align: center; padding: 56px 24px 8px; }
  .pc-loc__lede { max-width: 620px; margin: 14px auto 0; font-family: var(--font-display); font-size: 16px; line-height: 1.7; }
  .pc-loc__list { max-width: 1040px; margin: 0 auto; padding: 32px 24px 64px; display: flex; flex-direction: column; gap: 28px; }
  .pc-loc__divider { max-width: 1040px; margin: 24px auto 0; padding: 0 24px; display: flex; align-items: center; gap: 16px; }
  .pc-loc__divider::before, .pc-loc__divider::after { content: ""; flex: 1; height: 1.5px; background: var(--color-line); }
  .pc-loc__divider-label { font-family: var(--font-headline); text-transform: uppercase; letter-spacing: 0.04em; font-size: clamp(20px, 4vw, 28px); }
  .pc-loc__empty { max-width: 1040px; margin: 0 auto; padding: 0 24px 48px; font-family: var(--font-display); opacity: 0.7; text-align: center; }
  .pc-loc__note { max-width: 760px; margin: 0 auto; padding: 8px 24px 64px; font-family: var(--font-display); font-size: 15px; line-height: 1.7; text-align: center; opacity: 0.85; }
  .pc-loc__note a { color: inherit; }
  .pc-loc__note-label { font-family: var(--font-display); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; margin-bottom: 8px; }

  /* ---------- CARD ---------- */
  .pc-loc-card { background: var(--color-bg-card); border: 2px solid var(--color-ink); border-radius: var(--radius-soft);
    box-shadow: var(--shadow-stamp); overflow: hidden; display: grid; grid-template-columns: 1fr; }
  .pc-loc-card__media { position: relative; aspect-ratio: 4/3; background: var(--color-bg-warm); border-bottom: 2px solid var(--color-ink); }
  .pc-loc-card__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pc-loc-card__placeholder { position: absolute; inset: 0; display: grid; place-items: center; padding: 16px; text-align: center;
    font-family: var(--font-headline); text-transform: uppercase; letter-spacing: 0.02em; font-size: 20px; color: var(--color-ink); opacity: 0.5; }
  .pc-loc-card__body { padding: 26px 26px 28px; }
  .pc-loc-card__dates { display: inline-block; margin-bottom: 12px; font-family: var(--font-display); font-size: 12px; letter-spacing: 0.08em;
    text-transform: uppercase; padding: 6px 14px; background: var(--accent); border: 1.5px solid var(--color-ink); border-radius: var(--radius-pill); }
  .pc-loc-card__name { margin: 0 0 16px; font-family: var(--font-headline); font-weight: 400; text-transform: uppercase; letter-spacing: 0.02em;
    font-size: clamp(26px, 4.5vw, 40px); line-height: 1; }
  .pc-loc-card__row { display: flex; gap: 14px; padding: 10px 0; border-top: 1px solid var(--color-line-soft); }
  .pc-loc-card__row:first-of-type { border-top: 0; }
  .pc-loc-card__label { flex: 0 0 88px; font-family: var(--font-display); font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0.6; padding-top: 2px; }
  .pc-loc-card__text { font-family: var(--font-display); font-size: 15px; line-height: 1.6; min-width: 0; }
  .pc-loc-card__text a { color: inherit; }
  .pc-loc-card__maplink { display: inline-block; margin-top: 6px; font-size: 13px; letter-spacing: 0.04em; text-decoration: underline; text-underline-offset: 3px; }
  .pc-loc-card__desc { margin: 16px 0 0; font-family: var(--font-display); font-size: 15px; line-height: 1.7; }
  .pc-loc-card__products { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--color-line-soft); }
  .pc-loc-card__products .pc-loc-card__text { margin-top: 6px; }
  .pc-loc-card__products ul { margin: 6px 0 0; padding-left: 18px; }
  .pc-loc-card--past { opacity: 0.62; }

  @media (min-width: 800px) {
    .pc-loc-card { grid-template-columns: 1fr 1fr; align-items: stretch; }
    .pc-loc-card__media { aspect-ratio: auto; height: 100%; min-height: 320px; border-bottom: 0; border-right: 2px solid var(--color-ink); }
    .pc-loc-card__body { align-self: center; }
    .pc-loc-card--flip .pc-loc-card__media { order: 2; border-right: 0; border-left: 2px solid var(--color-ink); }
  }
{%- endstyle -%}

{%- comment -%} ---- Stockist blocks (block order) ---- {%- endcomment -%}
{%- assign stockist_count = 0 -%}
{%- capture stockist_cards -%}
  {%- assign si = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'stockist' -%}{%- continue -%}{%- endif -%}
    {%- assign m = si | modulo: 2 -%}
    {%- assign flip_b = false -%}
    {%- if m == 1 -%}{%- assign flip_b = true -%}{%- endif -%}
    {% render 'postcard-location-card',
        name: block.settings.name, image: block.settings.image, dates: '',
        address: block.settings.address, map_url: block.settings.map_url,
        hours: block.settings.opening_hours, description: block.settings.description,
        products_html: block.settings.products, flip: flip_b %}
    {%- assign si = si | plus: 1 -%}
    {%- assign stockist_count = stockist_count | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

{%- comment -%} ---- Pop-up blocks: current vs past ---- {%- endcomment -%}
{%- assign current_count = 0 -%}
{%- assign past_count = 0 -%}
{%- assign popup_total = 0 -%}

{%- capture current_cards -%}
  {%- assign ci = 0 -%}
  {%- for block in section.blocks -%}
    {%- if block.type != 'popup' -%}{%- continue -%}{%- endif -%}
    {%- assign popup_total = popup_total | plus: 1 -%}
    {%- assign sd = block.settings.start_date -%}
    {%- assign ed = block.settings.end_date -%}
    {%- assign end_basis = ed | default: sd -%}
    {%- assign is_current = true -%}
    {%- if end_basis != blank -%}
      {%- assign end_s = end_basis | date: '%s' | plus: 86400 -%}
      {%- if end_s < now_s -%}{%- assign is_current = false -%}{%- endif -%}
    {%- endif -%}
    {%- if is_current -%}
      {%- assign dstr = '' -%}
      {%- if block.settings.display_dates != blank -%}
        {%- assign dstr = block.settings.display_dates -%}
      {%- elsif sd != blank -%}
        {%- assign sm = sd | date: '%b' -%}
        {%- assign em = ed | date: '%b' -%}
        {%- if ed == blank -%}
          {%- assign dstr = sd | date: '%-d %b %Y' -%}
        {%- elsif sm == em -%}
          {%- assign d_end = ed | date: '%-d %b %Y' -%}
          {%- assign dstr = sd | date: '%-d' | append: '–' | append: d_end -%}
        {%- else -%}
          {%- assign d_end = ed | date: '%-d %b %Y' -%}
          {%- assign dstr = sd | date: '%-d %b' | append: ' – ' | append: d_end -%}
        {%- endif -%}
      {%- endif -%}
      {%- assign m = ci | modulo: 2 -%}
      {%- assign flip_b = false -%}
      {%- if m == 1 -%}{%- assign flip_b = true -%}{%- endif -%}
      {% render 'postcard-location-card',
          name: block.settings.name, image: block.settings.image, dates: dstr,
          address: block.settings.address, map_url: block.settings.map_url,
          hours: block.settings.opening_hours, description: block.settings.description,
          products_html: block.settings.products, flip: flip_b %}
      {%- assign ci = ci | plus: 1 -%}
      {%- assign current_count = current_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- capture past_cards -%}
  {%- assign pj = 0 -%}
  {%- for block in section.blocks reversed -%}
    {%- if block.type != 'popup' -%}{%- continue -%}{%- endif -%}
    {%- assign sd = block.settings.start_date -%}
    {%- assign ed = block.settings.end_date -%}
    {%- assign end_basis = ed | default: sd -%}
    {%- if end_basis == blank -%}{%- continue -%}{%- endif -%}
    {%- assign end_s = end_basis | date: '%s' | plus: 86400 -%}
    {%- if end_s >= now_s -%}{%- continue -%}{%- endif -%}
    {%- assign dstr = '' -%}
    {%- if block.settings.display_dates != blank -%}
      {%- assign dstr = block.settings.display_dates -%}
    {%- elsif sd != blank -%}
      {%- assign sm = sd | date: '%b' -%}
      {%- assign em = ed | date: '%b' -%}
      {%- if ed == blank -%}
        {%- assign dstr = sd | date: '%-d %b %Y' -%}
      {%- elsif sm == em -%}
        {%- assign d_end = ed | date: '%-d %b %Y' -%}
        {%- assign dstr = sd | date: '%-d' | append: '–' | append: d_end -%}
      {%- else -%}
        {%- assign d_end = ed | date: '%-d %b %Y' -%}
        {%- assign dstr = sd | date: '%-d %b' | append: ' – ' | append: d_end -%}
      {%- endif -%}
    {%- endif -%}
    {%- assign m = pj | modulo: 2 -%}
    {%- assign flip_b = false -%}
    {%- if m == 1 -%}{%- assign flip_b = true -%}{%- endif -%}
    {% render 'postcard-location-card',
        name: block.settings.name, image: block.settings.image, dates: dstr,
        address: block.settings.address, map_url: block.settings.map_url,
        hours: block.settings.opening_hours, description: block.settings.description,
        products_html: block.settings.products, is_past: true, flip: flip_b %}
    {%- assign pj = pj | plus: 1 -%}
    {%- assign past_count = past_count | plus: 1 -%}
  {%- endfor -%}
{%- endcapture -%}

<div class="pc-loc">
  {%- if section.settings.title != blank or section.settings.eyebrow != blank or section.settings.lede != blank -%}
    <section class="pc-loc__hero">
      {%- if section.settings.eyebrow != blank -%}<div class="eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.title != blank -%}<h1 class="h-display">{{ section.settings.title }}</h1>{%- endif -%}
      {%- if section.settings.lede != blank -%}<p class="pc-loc__lede">{{ section.settings.lede }}</p>{%- endif -%}
    </section>
  {%- endif -%}

  {%- if stockist_count > 0 -%}
    <div class="pc-loc__list">{{ stockist_cards }}</div>
  {%- endif -%}

  {%- if popup_total > 0 -%}
    {%- if current_count > 0 -%}
      <div class="pc-loc__list">{{ current_cards }}</div>
    {%- elsif stockist_count == 0 -%}
      <p class="pc-loc__empty">{{ section.settings.empty_text }}</p>
    {%- endif -%}
    {%- if past_count > 0 -%}
      <div class="pc-loc__divider"><span class="pc-loc__divider-label">{{ section.settings.past_label }}</span></div>
      <div class="pc-loc__list">{{ past_cards }}</div>
    {%- endif -%}
  {%- endif -%}

  {%- if stockist_count == 0 and popup_total == 0 -%}
    <p class="pc-loc__empty">{{ section.settings.empty_text }}</p>
  {%- endif -%}

  {%- if section.settings.footer_note != blank -%}
    <div class="pc-loc__note">
      {%- if section.settings.footer_note_label != blank -%}<div class="pc-loc__note-label">{{ section.settings.footer_note_label }}</div>{%- endif -%}
      <div class="rte">{{ section.settings.footer_note }}</div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Locations list",
  "tag": "section",
  "max_blocks": 50,
  "settings": [
    { "type": "color", "id": "accent_color", "label": "Accent colour", "default": "#FFB233", "info": "Used for the pop-up date badge." },
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "textarea", "id": "lede", "label": "Intro text" },
    { "type": "header", "content": "Labels" },
    { "type": "text", "id": "past_label", "label": "Past pop-ups heading", "default": "Past pop-ups" },
    { "type": "text", "id": "empty_text", "label": "Empty state text", "default": "Nothing to show here just yet — check back soon." },
    { "type": "header", "content": "Footer note (optional)" },
    { "type": "text", "id": "footer_note_label", "label": "Note label" },
    { "type": "richtext", "id": "footer_note", "label": "Note" }
  ],
  "blocks": [
    {
      "type": "stockist",
      "name": "Stockist",
      "settings": [
        { "type": "text", "id": "name", "label": "Location name" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "address", "label": "Address", "info": "One line per line break." },
        { "type": "url", "id": "map_url", "label": "Map / directions link" },
        { "type": "textarea", "id": "opening_hours", "label": "Opening hours" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "richtext", "id": "products", "label": "Products available", "info": "Type names and hyperlink them to product pages." }
      ]
    },
    {
      "type": "popup",
      "name": "Pop-up",
      "settings": [
        { "type": "text", "id": "name", "label": "Location / event name" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "start_date", "label": "Start date", "info": "Format: YYYY-MM-DD (e.g. 2026-11-01)." },
        { "type": "text", "id": "end_date", "label": "End date", "info": "Format: YYYY-MM-DD. After this, the pop-up moves to Past pop-ups." },
        { "type": "text", "id": "display_dates", "label": "Date label override", "info": "Optional. Overrides the auto-formatted date range shown on the badge." },
        { "type": "textarea", "id": "address", "label": "Address", "info": "One line per line break." },
        { "type": "url", "id": "map_url", "label": "Map / directions link" },
        { "type": "textarea", "id": "opening_hours", "label": "Opening hours" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "richtext", "id": "products", "label": "Products available", "info": "Type names and hyperlink them to product pages." }
      ]
    }
  ],
  "presets": [
    { "name": "Locations list", "blocks": [ { "type": "stockist" } ] }
  ]
}
{% endschema %}
