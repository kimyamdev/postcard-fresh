{%- comment -%}
  Postcard Christmas — Featured gifts. Product grid pulled from a collection.
{%- endcomment -%}

{%- liquid
  assign red = section.settings.color_red | default: '#A8403A'
  assign gold = section.settings.color_gold | default: '#E8C36A'
  assign featured = section.settings.featured_collection
-%}

{%- style -%}
  .pc-xmas-sec-{{ section.id }} { padding: clamp(36px, 6vw, 72px) 0; }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-section__head { text-align: center; margin-bottom: clamp(24px, 4vw, 44px); }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-section__eyebrow { font-family: var(--font-display); letter-spacing: 0.18em; text-transform: uppercase; font-size: 12px; color: {{ red }}; margin-bottom: 10px; }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-section__title { font-family: var(--font-headline); text-transform: uppercase; font-size: clamp(28px, 5vw, 48px); line-height: 1; color: var(--color-ink); margin: 0; }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-gifts__grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(12px, 2vw, 22px); }
  @media (min-width: 750px) { .pc-xmas-sec-{{ section.id }} .pc-xmas-gifts__grid { grid-template-columns: repeat(4, 1fr); } }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-gifts__cta { text-align: center; margin-top: 32px; }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-btn-gold { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; font-size: 13px; color: #15241b; background: {{ gold }}; padding: 14px 26px; border-radius: 999px; text-decoration: none; box-shadow: 0 5px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
  .pc-xmas-sec-{{ section.id }} .pc-xmas-btn-gold:hover { transform: translateY(2px); box-shadow: 0 3px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
{%- endstyle -%}

<section class="pc-xmas-sec-{{ section.id }}">
  <div class="container">
    <div class="pc-xmas-section__head">
      {%- if section.settings.eyebrow != blank -%}<div class="pc-xmas-section__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="pc-xmas-section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    </div>
    {%- if featured != blank and featured.products.size > 0 -%}
      <div class="pc-xmas-gifts__grid">
        {%- for product in featured.products limit: section.settings.featured_count -%}
          {% render 'product-card', product: product, badge: 'GIFT' %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_cta -%}
        <div class="pc-xmas-gifts__cta">
          <a class="pc-xmas-btn-gold" href="{{ featured.url }}">{{ section.settings.cta_text | default: 'Shop all Christmas gifts' }} &rarr;</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <p style="text-align:center; opacity:0.6; font-family: var(--font-display);">Pick a collection in this section's settings.</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Christmas · Gifts",
  "tag": "section",
  "settings": [
    { "type": "collection", "id": "featured_collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Under the tree" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most-wrapped this season" },
    { "type": "range", "id": "featured_count", "label": "How many", "min": 4, "max": 16, "step": 2, "default": 8 },
    { "type": "checkbox", "id": "show_cta", "label": "Show 'shop all' button", "default": true },
    { "type": "text", "id": "cta_text", "label": "Button text", "default": "Shop all Christmas gifts" },
    { "type": "header", "content": "Festive colours" },
    { "type": "color", "id": "color_red", "label": "Warm red", "default": "#A8403A" },
    { "type": "color", "id": "color_gold", "label": "Gold", "default": "#E8C36A" }
  ],
  "presets": [ { "name": "Christmas · Gifts" } ]
}
{% endschema %}
