{%- comment -%}
  Postcard Christmas — Closing band (festive CTA, e.g. corporate hampers).
{%- endcomment -%}

{%- liquid
  assign pine = section.settings.color_pine | default: '#33503F'
  assign gold = section.settings.color_gold | default: '#E8C36A'
-%}

{%- style -%}
  .pc-xmas-closing-{{ section.id }} { background: {{ pine }}; color: #fff5e1; padding: clamp(40px, 6vw, 72px) 0; text-align: center; position: relative; overflow: hidden; }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-closing__eyebrow { font-family: var(--font-display); letter-spacing: 0.2em; text-transform: uppercase; font-size: 12px; color: {{ gold }}; margin-bottom: 10px; }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-closing__title { font-family: var(--font-headline); text-transform: uppercase; font-size: clamp(28px, 5vw, 52px); line-height: 1; margin: 0 0 14px; }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-closing__body { max-width: 34rem; margin: 0 auto 24px; font-family: var(--font-display); line-height: 1.7; opacity: 0.92; }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-btn-gold { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; font-size: 13px; color: #15241b; background: {{ gold }}; padding: 14px 26px; border-radius: 999px; text-decoration: none; box-shadow: 0 5px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-btn-gold:hover { transform: translateY(2px); box-shadow: 0 3px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-snow { position: absolute; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
  .pc-xmas-closing-{{ section.id }} .pc-xmas-flake { position: absolute; top: -12px; color: #fff; opacity: 0.8; will-change: transform; }
  @keyframes pc-xmas-close-fall-{{ section.id }} { to { transform: translateY(var(--fall, 420px)) translateX(var(--drift, 16px)); } }
  @media (prefers-reduced-motion: reduce) { .pc-xmas-closing-{{ section.id }} .pc-xmas-flake { display: none; } }
{%- endstyle -%}

<section class="pc-xmas-closing-{{ section.id }}">
  {%- if section.settings.show_snow -%}<div class="pc-xmas-snow" data-snow-layer aria-hidden="true"></div>{%- endif -%}
  <div class="container" style="position: relative; z-index: 3;">
    {%- if section.settings.eyebrow != blank -%}<div class="pc-xmas-closing__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.title != blank -%}<h2 class="pc-xmas-closing__title">{{ section.settings.title }}</h2>{%- endif -%}
    {%- if section.settings.body != blank -%}<p class="pc-xmas-closing__body">{{ section.settings.body }}</p>{%- endif -%}
    {%- if section.settings.cta_text != blank -%}
      <a class="pc-xmas-btn-gold" href="{{ section.settings.link | default: '/pages/corporate' }}">{{ section.settings.cta_text }} &rarr;</a>
    {%- endif -%}
  </div>
</section>

{%- if section.settings.show_snow -%}
<script>
  (function () {
    var root = document.querySelector('.pc-xmas-closing-{{ section.id }}');
    if (!root || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var layer = root.querySelector('[data-snow-layer]');
    if (!layer) return;
    function setFall() { layer.style.setProperty('--fall', (root.offsetHeight + 24) + 'px'); }
    setFall(); window.addEventListener('resize', setFall);
    var chars = ['❄', '❅', '·'];
    for (var i = 0; i < 20; i++) {
      var f = document.createElement('span');
      f.className = 'pc-xmas-flake';
      f.textContent = chars[i % chars.length];
      f.style.left = ((i * 41) % 100) + '%';
      f.style.fontSize = (6 + ((i * 5) % 12)) + 'px';
      f.style.setProperty('--drift', ((((i % 5) - 2) * 14)) + 'px');
      f.style.animation = 'pc-xmas-close-fall-{{ section.id }} ' + (7 + ((i * 7) % 8)) + 's linear ' + (-((i * 9) % 10)) + 's infinite';
      layer.appendChild(f);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Christmas · Closing band",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bigger than a stocking?" },
    { "type": "text", "id": "title", "label": "Title", "default": "Gift the whole team." },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Bespoke festive hampers for hotels, weddings and bossy bosses. From 20 units up." },
    { "type": "text", "id": "cta_text", "label": "Button", "default": "Talk to corporate" },
    { "type": "url", "id": "link", "label": "Button link" },
    { "type": "checkbox", "id": "show_snow", "label": "Snow", "default": true },
    { "type": "header", "content": "Festive colours" },
    { "type": "color", "id": "color_pine", "label": "Pine", "default": "#33503F" },
    { "type": "color", "id": "color_gold", "label": "Gold", "default": "#E8C36A" }
  ],
  "presets": [ { "name": "Christmas · Closing band" } ]
}
{% endschema %}
