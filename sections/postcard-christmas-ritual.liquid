{%- comment -%}
  Postcard Christmas — Ritual in a Box. An intro + six scent-world cards (blocks).
  Each world: number, title, tagline, description, image (world stamp or lifestyle),
  accent colour and a link (usually to the Ritual in a Box product variant).
{%- endcomment -%}

{%- liquid
  assign gold = section.settings.color_gold | default: '#E8C36A'
  assign ink = section.settings.color_ink | default: '#212020'
-%}

{%- style -%}
  .pc-rib-{{ section.id }} { padding: clamp(40px, 7vw, 88px) 0;{% if section.settings.bg_warm %} background: var(--color-bg-warm);{% endif %} }
  .pc-rib-{{ section.id }} .pc-rib__head { text-align: center; max-width: 44rem; margin: 0 auto clamp(28px, 5vw, 52px); }
  .pc-rib-{{ section.id }} .pc-rib__eyebrow { font-family: var(--font-display); letter-spacing: 0.2em; text-transform: uppercase; font-size: 12px; color: color-mix(in srgb, {{ gold }} 80%, #000); margin-bottom: 12px; }
  .pc-rib-{{ section.id }} .pc-rib__title { font-family: var(--font-headline); text-transform: uppercase; letter-spacing: 0.02em; font-size: clamp(30px, 6vw, 60px); line-height: 0.95; color: {{ ink }}; margin: 0 0 10px; }
  .pc-rib-{{ section.id }} .pc-rib__tagline { font-family: var(--font-script); color: color-mix(in srgb, {{ gold }} 85%, #000); font-size: clamp(22px, 4vw, 34px); line-height: 1.05; margin-bottom: 14px; }
  .pc-rib-{{ section.id }} .pc-rib__intro { font-family: var(--font-display); line-height: 1.75; color: {{ ink }}; }
  .pc-rib-{{ section.id }} .pc-rib__intro p { margin: 0 0 0.8em; }

  .pc-rib-{{ section.id }} .pc-rib__grid { display: grid; grid-template-columns: 1fr; gap: clamp(16px, 2.5vw, 28px); }
  @media (min-width: 750px) { .pc-rib-{{ section.id }} .pc-rib__grid { grid-template-columns: repeat(2, 1fr); } }

  .pc-rib-{{ section.id }} .pc-rib-card {
    display: flex; flex-direction: column; text-decoration: none; color: {{ ink }};
    background: var(--color-bg-card, #fffdf4); border: 1.5px solid var(--color-line);
    border-radius: 3px; overflow: hidden; transition: transform 0.15s ease, box-shadow 0.15s ease;
  }
  .pc-rib-{{ section.id }} .pc-rib-card:hover { transform: translateY(-3px); box-shadow: var(--shadow-stamp); }
  .pc-rib-{{ section.id }} .pc-rib-card__media {
    position: relative; aspect-ratio: 16 / 10; overflow: hidden; display: flex; align-items: center; justify-content: center;
    background: radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--accent, {{ gold }}) 55%, #fff) 0%, color-mix(in srgb, var(--accent, {{ gold }}) 22%, #fff) 70%, #fff 100%);
  }
  .pc-rib-{{ section.id }} .pc-rib-slides { position: absolute; inset: 0; }
  .pc-rib-{{ section.id }} .pc-rib-slide { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.6s ease; }
  .pc-rib-{{ section.id }} .pc-rib-slide.is-active { opacity: 1; }
  .pc-rib-{{ section.id }} .pc-rib-slide img { display: block; }
  .pc-rib-{{ section.id }} .pc-rib-slide img.is-contain { max-width: 56%; max-height: 80%; object-fit: contain; }
  .pc-rib-{{ section.id }} .pc-rib-slide img.is-cover { width: 100%; height: 100%; object-fit: cover; }
  .pc-rib-{{ section.id }} .pc-rib-dots { position: absolute; bottom: 10px; left: 0; right: 0; display: flex; gap: 6px; justify-content: center; z-index: 3; }
  .pc-rib-{{ section.id }} .pc-rib-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(33,32,32,0.22); transition: background 0.2s ease; }
  .pc-rib-{{ section.id }} .pc-rib-dot.is-active { background: color-mix(in srgb, var(--accent, {{ gold }}) 90%, #000); }
  .pc-rib-{{ section.id }} .pc-rib-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 4; width: 32px; height: 32px; border-radius: 50%; background: rgba(255,255,255,0.85); color: #212020; display: flex; align-items: center; justify-content: center; font-size: 22px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity 0.15s ease; box-shadow: 0 1px 5px rgba(0,0,0,0.22); user-select: none; }
  .pc-rib-{{ section.id }} .pc-rib-arrow:hover { background: #fff; }
  .pc-rib-{{ section.id }} .pc-rib-card:hover .pc-rib-arrow { opacity: 1; }
  .pc-rib-{{ section.id }} .pc-rib-arrow--prev { left: 10px; }
  .pc-rib-{{ section.id }} .pc-rib-arrow--next { right: 10px; }
  @media (hover: none) { .pc-rib-{{ section.id }} .pc-rib-arrow { opacity: 0.9; } }
  .pc-rib-{{ section.id }} .pc-rib-card__ph { font-family: var(--font-headline); font-size: clamp(40px, 7vw, 72px); color: color-mix(in srgb, var(--accent, {{ gold }}) 70%, #000); opacity: 0.5; }
  .pc-rib-{{ section.id }} .pc-rib-card__num {
    position: absolute; top: 12px; left: 12px; z-index: 2;
    font-family: var(--font-headline); font-size: 14px; letter-spacing: 0.08em;
    background: {{ ink }}; color: #fff; padding: 3px 9px; border-radius: 2px;
  }
  .pc-rib-{{ section.id }} .pc-rib-card__body { padding: clamp(18px, 2.4vw, 26px); display: flex; flex-direction: column; }
  .pc-rib-{{ section.id }} .pc-rib-card__name { font-family: var(--font-headline); text-transform: uppercase; font-size: clamp(20px, 2.6vw, 26px); line-height: 1; margin: 0; }
  .pc-rib-{{ section.id }} .pc-rib-card__tag { font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.12em; font-size: 11px; color: color-mix(in srgb, var(--accent, {{ gold }}) 70%, #000); margin: 8px 0 12px; }
  .pc-rib-{{ section.id }} .pc-rib-card__desc { font-family: var(--font-display); font-size: 14.5px; line-height: 1.7; color: {{ ink }}; }
  .pc-rib-{{ section.id }} .pc-rib-card__desc p { margin: 0 0 0.7em; }
  .pc-rib-{{ section.id }} .pc-rib-card__desc p:last-child { margin-bottom: 0; }
  .pc-rib-{{ section.id }} .pc-rib-card__cta { margin-top: 14px; font-family: var(--font-display); letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; color: {{ ink }}; }
  .pc-rib-{{ section.id }} .pc-rib-card:hover .pc-rib-card__cta { text-decoration: underline; text-underline-offset: 0.2em; }

  .pc-rib-{{ section.id }} .pc-rib__foot { text-align: center; margin-top: clamp(28px, 4vw, 44px); }
  .pc-rib-{{ section.id }} .pc-rib__btn { display: inline-flex; align-items: center; gap: 10px; font-family: var(--font-display); letter-spacing: 0.1em; text-transform: uppercase; font-size: 13px; color: #15241b; background: {{ gold }}; padding: 14px 28px; border-radius: 999px; text-decoration: none; box-shadow: 0 5px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
  .pc-rib-{{ section.id }} .pc-rib__btn:hover { transform: translateY(2px); box-shadow: 0 3px 0 color-mix(in srgb, {{ gold }} 55%, #000); }
{%- endstyle -%}

<section class="pc-rib-{{ section.id }}">
  <div class="container">
    <div class="pc-rib__head">
      {%- if section.settings.eyebrow != blank -%}<div class="pc-rib__eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
      {%- if section.settings.title != blank -%}<h2 class="pc-rib__title">{{ section.settings.title }}</h2>{%- endif -%}
      {%- if section.settings.tagline != blank -%}<div class="pc-rib__tagline">{{ section.settings.tagline }}</div>{%- endif -%}
      {%- if section.settings.intro != blank -%}<div class="pc-rib__intro rte">{{ section.settings.intro }}</div>{%- endif -%}
    </div>

    <div class="pc-rib__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign fit_class = 'is-contain'
          if block.settings.image_fit == 'cover'
            assign fit_class = 'is-cover'
          endif
          assign has_link = false
          if block.settings.link != blank
            assign has_link = true
          endif
        -%}
        <a class="pc-rib-card"{% if has_link %} href="{{ block.settings.link }}"{% endif %} style="--accent: {{ block.settings.color | default: gold }};" {{ block.shopify_attributes }}>
          {%- liquid
            assign slide_count = 0
            if block.settings.image != blank
              assign slide_count = slide_count | plus: 1
            endif
            if block.settings.image_2 != blank
              assign slide_count = slide_count | plus: 1
            endif
            if block.settings.image_3 != blank
              assign slide_count = slide_count | plus: 1
            endif
            if block.settings.image_4 != blank
              assign slide_count = slide_count | plus: 1
            endif
            if block.settings.image_5 != blank
              assign slide_count = slide_count | plus: 1
            endif
            # A slideshow (2+ images) fills the frame; a single stamp keeps its fit.
            assign slide_fit = fit_class
            if slide_count > 1
              assign slide_fit = 'is-cover'
            endif
          -%}
          <div class="pc-rib-card__media">
            {%- if block.settings.number != blank -%}<span class="pc-rib-card__num">{{ block.settings.number }}</span>{%- endif -%}
            {%- if slide_count > 0 -%}
              <div class="pc-rib-slides" data-rib-slides>
                {%- assign active_set = false -%}
                {%- for n in (1..5) -%}
                  {%- case n -%}
                    {%- when 1 -%}{%- assign im = block.settings.image -%}
                    {%- when 2 -%}{%- assign im = block.settings.image_2 -%}
                    {%- when 3 -%}{%- assign im = block.settings.image_3 -%}
                    {%- when 4 -%}{%- assign im = block.settings.image_4 -%}
                    {%- when 5 -%}{%- assign im = block.settings.image_5 -%}
                  {%- endcase -%}
                  {%- if im != blank -%}
                    <div class="pc-rib-slide{% unless active_set %} is-active{% endunless %}" data-rib-slide>
                      {{ im | image_url: width: 1000 | image_tag: loading: 'lazy', class: slide_fit, alt: block.settings.title }}
                    </div>
                    {%- assign active_set = true -%}
                  {%- endif -%}
                {%- endfor -%}
              </div>
              {%- if slide_count > 1 -%}
                <span class="pc-rib-arrow pc-rib-arrow--prev" data-rib-prev role="button" aria-label="Previous image">&lsaquo;</span>
                <span class="pc-rib-arrow pc-rib-arrow--next" data-rib-next role="button" aria-label="Next image">&rsaquo;</span>
                <div class="pc-rib-dots" data-rib-dots aria-hidden="true">
                  {%- for d in (1..slide_count) -%}<span class="pc-rib-dot{% if forloop.first %} is-active{% endif %}"></span>{%- endfor -%}
                </div>
              {%- endif -%}
            {%- else -%}
              <span class="pc-rib-card__ph" aria-hidden="true">{{ block.settings.title | slice: 0, 2 | upcase }}</span>
            {%- endif -%}
          </div>
          <div class="pc-rib-card__body">
            {%- if block.settings.title != blank -%}<h3 class="pc-rib-card__name">{{ block.settings.title }}</h3>{%- endif -%}
            {%- if block.settings.tagline != blank -%}<div class="pc-rib-card__tag">{{ block.settings.tagline }}</div>{%- endif -%}
            {%- if block.settings.description != blank -%}<div class="pc-rib-card__desc rte">{{ block.settings.description }}</div>{%- endif -%}
            {%- if has_link -%}<span class="pc-rib-card__cta">{{ block.settings.cta_text | default: 'Explore this box' }} &rarr;</span>{%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>

    {%- if section.settings.foot_cta_text != blank -%}
      <div class="pc-rib__foot">
        <a class="pc-rib__btn" href="{{ section.settings.foot_cta_link | default: '#' }}">{{ section.settings.foot_cta_text }} &rarr;</a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.querySelectorAll('.pc-rib-{{ section.id }} [data-rib-slides]').forEach(function (wrap) {
      var slides = wrap.querySelectorAll('[data-rib-slide]');
      if (slides.length < 2) return;
      var card = wrap.closest('.pc-rib-card');
      var dots = card ? card.querySelectorAll('[data-rib-dot]') : [];
      var i = 0, timer = null;
      function show(n) {
        slides[i].classList.remove('is-active'); if (dots[i]) dots[i].classList.remove('is-active');
        i = (n + slides.length) % slides.length;
        slides[i].classList.add('is-active'); if (dots[i]) dots[i].classList.add('is-active');
      }
      function start() { if (reduce) return; stop(); timer = setInterval(function () { show(i + 1); }, 3500); }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }
      var manual = false;
      function step(dir, e) {
        if (e) { e.preventDefault(); e.stopPropagation(); }
        manual = true; stop(); show(i + dir);
      }
      if (card) {
        var prev = card.querySelector('[data-rib-prev]');
        var next = card.querySelector('[data-rib-next]');
        if (prev) prev.addEventListener('click', function (e) { step(-1, e); });
        if (next) next.addEventListener('click', function (e) { step(1, e); });
        card.addEventListener('mouseenter', stop);
        card.addEventListener('mouseleave', function () { if (!manual) start(); });
      }
      start();
    });
  })();
</script>

{% schema %}
{
  "name": "Christmas · Ritual",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ritual in a Box" },
    { "type": "text", "id": "title", "label": "Title", "default": "A little world to get lost in" },
    { "type": "text", "id": "tagline", "label": "Script tagline" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>More than a box of beautiful things, each Ritual in a Box is an invitation to experience one of our scent worlds beyond fragrance. Inside, you'll find a curated collection of POSTCARD essentials, thoughtfully chosen objects, a playlist and a little ritual to bring it all together.</p><p>Six different worlds, each with its own way of taking you somewhere else. Made for gifting, discovering and finding a little time for yourself.</p>" },
    { "type": "checkbox", "id": "bg_warm", "label": "Warm background", "default": false },
    { "type": "header", "content": "Footer button" },
    { "type": "text", "id": "foot_cta_text", "label": "Button text", "default": "Shop Ritual in a Box" },
    { "type": "url", "id": "foot_cta_link", "label": "Button link" },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "color_gold", "label": "Accent / gold", "default": "#E8C36A" },
    { "type": "color", "id": "color_ink", "label": "Ink", "default": "#212020" }
  ],
  "blocks": [
    {
      "type": "world_box",
      "name": "Scent world",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "World name", "default": "Hotel Lobby" },
        { "type": "text", "id": "tagline", "label": "Tagline", "default": "A little everyday luxury" },
        { "type": "richtext", "id": "description", "label": "Description" },
        { "type": "paragraph", "content": "Add 1 image for a single visual, or 2–5 to make the card a slideshow." },
        { "type": "image_picker", "id": "image", "label": "Image 1" },
        { "type": "image_picker", "id": "image_2", "label": "Image 2" },
        { "type": "image_picker", "id": "image_3", "label": "Image 3" },
        { "type": "image_picker", "id": "image_4", "label": "Image 4" },
        { "type": "image_picker", "id": "image_5", "label": "Image 5" },
        { "type": "select", "id": "image_fit", "label": "Image fit", "options": [ { "value": "contain", "label": "Contain (stamps/illustrations)" }, { "value": "cover", "label": "Cover (photos)" } ], "default": "contain" },
        { "type": "color", "id": "color", "label": "Accent colour", "default": "#E8C36A" },
        { "type": "url", "id": "link", "label": "Link (product variant)" },
        { "type": "text", "id": "cta_text", "label": "Card link text", "default": "Explore this box" }
      ]
    }
  ],
  "presets": [ { "name": "Christmas · Ritual", "blocks": [ { "type": "world_box" }, { "type": "world_box" }, { "type": "world_box" }, { "type": "world_box" }, { "type": "world_box" }, { "type": "world_box" } ] } ]
}
{% endschema %}
