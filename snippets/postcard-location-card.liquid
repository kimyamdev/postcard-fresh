{%- comment -%}
  Renders one stockist / pop-up card from explicit params (fed by theme-editor
  block settings in sections/postcard-locations.liquid).
  Params:
    name          — location / event name (string)
    image         — image object (image_picker) or blank
    dates         — formatted date range string (pop-ups only; blank to hide)
    address       — plain text, newlines become <br>
    map_url       — directions link (optional)
    hours         — plain text, newlines become <br>
    description   — plain text, newlines become <br>
    products_html — rich-text HTML (already rendered) for "Available here"
    is_past       — true to dim the card
    flip          — true to put the image on the right (desktop)
    anchor        — block id used as the card's #anchor (map pins link to it)
{%- endcomment -%}
<article {% if anchor != blank %}id="loc-{{ anchor }}" {% endif %}class="pc-loc-card{% if flip %} pc-loc-card--flip{% endif %}{% if is_past %} pc-loc-card--past{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
  <div class="pc-loc-card__media">
    {%- if image != blank -%}
      {%- assign loc_alt = image.alt | default: name | escape -%}
      {{ image | image_url: width: 1200 | image_tag: alt: loc_alt, loading: 'lazy', widths: '400,700,1000,1200', sizes: '(min-width: 800px) 50vw, 100vw' }}
    {%- else -%}
      <span class="pc-loc-card__placeholder">{{ name | escape }}</span>
    {%- endif -%}
  </div>

  <div class="pc-loc-card__body">
    {%- if dates != blank -%}
      <div class="pc-loc-card__dates">{{ dates }}</div>
    {%- endif -%}

    <h2 class="h-display pc-loc-card__name">{{ name | escape }}</h2>

    {%- if address != blank -%}
      <div class="pc-loc-card__row">
        <span class="pc-loc-card__label">Where</span>
        <div class="pc-loc-card__text">
          {{ address | newline_to_br }}
          {%- if map_url != blank -%}
            <a class="pc-loc-card__maplink" href="{{ map_url }}" target="_blank" rel="noopener">Get directions →</a>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}

    {%- if hours != blank -%}
      <div class="pc-loc-card__row">
        <span class="pc-loc-card__label">Hours</span>
        <div class="pc-loc-card__text">{{ hours | newline_to_br }}</div>
      </div>
    {%- endif -%}

    {%- if description != blank -%}
      <p class="pc-loc-card__desc">{{ description | newline_to_br }}</p>
    {%- endif -%}

    {%- if products_html != blank -%}
      <div class="pc-loc-card__products">
        <span class="pc-loc-card__label">Available here</span>
        <div class="pc-loc-card__text rte">{{ products_html }}</div>
      </div>
    {%- endif -%}
  </div>
</article>
